prebuilt_etc {
    name: "codec2.vendor.base.policy",
    vendor: true,
    sub_dir: "seccomp_policy",

    src: "seccomp_policy/codec2.vendor.base-arm.policy",

    required: ["crash_dump.policy"],
}

prebuilt_etc {
    name: "codec2.vendor.ext.policy",
    vendor: true,
    sub_dir: "seccomp_policy",

    src: "seccomp_policy/codec2.vendor.ext-arm.policy",

    required: ["crash_dump.policy"],
}

cc_defaults {
    name: "codec_defaults",
    vendor: true,
    relative_install_path: "hw",
    cflags: [
        "-Werror",
        "-Wall",
        "-Wno-unused-parameter",
    ] + select(soong_config_variable("openmax", "USE_FULL_ST2094_40"), {
        true: ["-DUSE_FULL_ST2094_40"],
        default: [],
    }),
    srcs: ["vendor.cpp"],
    include_dirs: [
        "frameworks/av/media/libstagefright/include",
        "frameworks/native/include",
        "frameworks/av/media/codec2/vndk/include",
    ],
    shared_libs: [
        "libcodec2",
        "libcodec2_hal_common",
        "server_configurable_flags",
        "libavservices_minijail",
        "libbinder",
        "libcodec2_vndk",
        "libbinder_ndk",
        "liblog",
        "libstagefright_xmlparser",
        "libutils",
        "libExynosC2ComponentStore",
    ],
    header_libs: [
        "libexynosc2_base_headers",
        "libexynosc2_osal_headers",
        "media_plugin_headers",
        "libexynos_headers",
    ]
}

cc_binary {
    name: "samsung.hardware.media.c2-service",
    defaults: ["codec_defaults"],
    init_rc: ["samsung.hardware.media.c2-service.rc"],
    vintf_fragments: ["samsung.hardware.media.c2-service.xml"],
    include_dirs: ["frameworks/av/media/codec2/hal/aidl/include"],
    shared_libs: [
        "android.hardware.media.c2-V1-ndk",
        "libcodec2_aidl",
    ],
    required: [
        "codec2.vendor.base.policy",
        "codec2.vendor.ext.policy",
    ],
}
