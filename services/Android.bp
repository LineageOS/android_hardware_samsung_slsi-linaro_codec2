prebuilt_etc {
    name: "codec2.vendor.base.policy",
    vendor: true,
    sub_dir: "seccomp_policy",

    src: "seccomp_policy/codec2.vendor.base-arm.policy",

    required: ["crash_dump.policy"],
}

prebuilt_etc {
    name: "codec2.vendor.ext.policy",
    vendor: true,
    sub_dir: "seccomp_policy",

    src: "seccomp_policy/codec2.vendor.ext-arm.policy",

    required: ["crash_dump.policy"],
}

cc_defaults {
    name: "codec_defaults",
    vendor: true,
    relative_install_path: "hw",
    cflags: [
        "-Werror",
        "-Wall",
        "-Wno-unused-parameter",
    ],
    srcs: ["vendor.cpp"],
    include_dirs: [
        "frameworks/av/media/libstagefright/include",
        "frameworks/native/include",
        "frameworks/av/media/codec2/vndk/include",
    ],
    shared_libs: [
        "android.hardware.media.omx@1.0",
        "libavservices_minijail",
        "libbinder",
        "libcodec2_vndk",
        "libhidlbase",
        "liblog",
        "libstagefright_omx",
        "libstagefright_xmlparser",
        "libutils",
        "libExynosC2ComponentStore",
    ],
    header_libs: [
        "libexynosc2_base_headers",
        "libexynosc2_osal_headers",
        "media_plugin_headers",
        "libexynos_headers",
    ]
}

cc_binary {
    name: "samsung.hardware.media.c2@1.0-service",
    defaults: ["codec_defaults"],
    init_rc: ["samsung.hardware.media.c2@1.0-service.rc"],
    include_dirs: ["frameworks/av/media/codec2/hal/hidl/1.0/utils/include"],
    shared_libs: [
        "android.hardware.media.c2@1.0",
        "libcodec2_hidl@1.0",
    ],
    required: [
        "codec2.vendor.base.policy",
        "codec2.vendor.ext.policy",
    ],
}

cc_binary {
    name: "samsung.hardware.media.c2@1.2-service",
    defaults: ["codec_defaults"],
    init_rc: ["samsung.hardware.media.c2@1.2-service.rc"],
    cflags: ["-DUSE_CODEC2_HIDL_1_2"],
    include_dirs: ["frameworks/av/media/codec2/hal/hidl/1.2/utils/include"],
    shared_libs: [
        "android.hardware.media.c2@1.2",
        "libcodec2_hidl@1.2",
    ],
    required: [
        "codec2.vendor.base.policy",
        "codec2.vendor.ext.policy",
    ],
}