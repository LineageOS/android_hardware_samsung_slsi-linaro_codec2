package {
    default_applicable_licenses: ["hardware_samsung_slsi-linaro_codec2_csc_license"],
}

// Added automatically by a large-scale-change
// See: http://go/android-license-faq
license {
    name: "hardware_samsung_slsi-linaro_codec2_csc_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "NOTICE",
    ],
}

cc_library_headers {
    name: "libexynosc2_csc_headers",
    proprietary: true,
    compile_multilib: "both",
    export_include_dirs: [
        "./",
    ],
    header_libs: [
        "libexynosc2_base_headers",
        "libexynosc2_osal_headers",
    ],
    export_header_lib_headers: [
        "libexynosc2_base_headers",
        "libexynosc2_osal_headers",
    ],
}

cc_library_static {
    name: "libExynosCSC",
    proprietary: true,
    cflags: [
        "-fPIC",
        "-O3",
        "-Werror",
        "-Wall",
        "-std=gnu++1z",
        "-std=c++2a",
    ] + select(soong_config_variable("openmax", "GPU_TYPE"), {
        "sgpu": [
            "-DHW_GPU_ALIGN=256",
        ],
        default: [],
    }) + select(soong_config_variable("openmax", "USE_FULL_ST2094_40"), {
        true: ["-DUSE_FULL_ST2094_40"],
        default: [],
    }),

    header_libs: [
        "libexynosc2_csc_headers",
        "libexynos_headers",
    ],
    static_libs: [
        "libExynosC2OSAL",
    ],
    shared_libs: [
        "libacryl",
        "libcutils",
        "libutils",
        "libhardware",
        "libhidlbase",
        "libexynosv4l2",
        "libion_exynos",
        "libui",
        "libexynosgraphicbuffer",
    ],
    srcs: [
        "ExynosCSC.cpp",
    ],
}
