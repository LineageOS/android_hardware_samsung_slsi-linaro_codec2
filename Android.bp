soong_namespace {
    imports: [
        "hardware/samsung_slsi-linaro/exynos",
        "hardware/samsung_slsi-linaro/graphics",
    ],
}

package {
    default_applicable_licenses: ["hardware_samsung_slsi-linaro_codec2_license"],
}

// Added automatically by a large-scale-change
// See: http://go/android-license-faq
license {
    name: "hardware_samsung_slsi-linaro_codec2_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "NOTICE",
    ],
}

kernel_headers {
    name: "exynos_codec2_kernel_headers",
    vendor: true,
}

cc_library_headers {
    name: "libexynosc2_base_headers",
    proprietary: true,
    compile_multilib: "both",

    header_libs: [
        "libsystem_headers",
        "libcutils_headers",
        "exynos_codec2_kernel_headers",
    ],
    export_header_lib_headers: [
        "libsystem_headers",
        "libcutils_headers",
    ],

    export_include_dirs: [
        "include",
        "include/api",
        "./",
    ],
}

cc_library_headers {
    name: "libexynos_video_api_headers",

    export_include_dirs: [
        "include/api",
    ],
}

cc_defaults {
    name: "libexynos_video_api_defaults",
    visibility: ["//frameworks/av:__subpackages__"],

    header_libs: [
        "//hardware/samsung_slsi-linaro/codec2:libexynos_video_api_headers",
    ],
    export_header_lib_headers: [
        "//hardware/samsung_slsi-linaro/codec2:libexynos_video_api_headers",
    ],

    cflags: ["-DUSE_EXYNOS_VIDEO_CONSTANTS"],
}

subdirs = [
    "osal",
    "videocodec",
    "csc",
    "filter",
    "c2component",
    "services",
]

cc_library_shared {
    name: "libExynosC2ComponentStore",
    proprietary: true,
    srcs: ["Exynos_C2_ComponentStore.cpp"],
    cflags: [
        "-fPIC",
        "-O3",
        "-Werror",
        "-Wall",
        "-Wno-deprecated-enum-enum-conversion",
        "-std=gnu++1z",
        "-std=c++2a",
    ],
    header_libs: [
        "libexynosc2_base_headers",
        "libexynosc2_osal_headers",
        "libexynos_headers",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libion",
        "libhidlbase",
        "libcodec2",
        "libcodec2_vndk",
        "libsfplugin_ccodec_utils",
        "libstagefright_xmlparser",
        "libion",
        "libui",
        "libexynosgraphicbuffer",
    ],
    static_libs: ["libExynosC2OSAL"],
}

cc_defaults {
    name: "libExynosC2_defaults",
    proprietary: true,
    srcs: [
        "c2component/Exynos_C2_Component.cpp",
        "c2component/Exynos_C2_IntfSetter.cpp",
        "c2component/Exynos_C2_FilterParamCnv.cpp",
        "filter/Exynos_Filter.cpp",
        "filter/codec/Exynos_CodecBase_Filter.cpp",
        "filter/csc/Exynos_CSC_Filter.cpp",
    ],
    cflags: [] + select(soong_config_variable("openmax", "USE_SW_CSC"), {
        "true": ["-DUSE_SW_CSC"],
        default: [],
    }),
    header_libs: [
        "libstagefright_foundation_headers",
        "libexynos_headers",
    ],
    static_libs: [
        "libExynosCSC",
        "libExynosVideoCodec",
        "libExynosC2OSAL",
        "libExynosVideoApi2",
        "libVendorVideoApi",
    ],
    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
        "libhidlbase",
        "libcodec2",
        "libcodec2_vndk",
        "libsfplugin_ccodec_utils",
        "libstagefright_foundation",
        "libstagefright_xmlparser",
        "libExynosC2ComponentStore",
        "libexynosv4l2",
        "libhardware",
        "libacryl",
        "libui",
        "libexynosgraphicbuffer",
        "libion_exynos",
    ],
}

cc_defaults {
    name: "libExynosC2_enc_defaults",
    defaults: ["libExynosC2_defaults"],
    srcs: [
        "c2component/Exynos_C2_EncComponent.cpp",
        "filter/codec/Exynos_CodecEncBase_Filter.cpp",
    ],
    cflags: [] + select(soong_config_variable("openmax", "USE_FLEXIBLE_P010"), {
        "true": ["-DUSE_FLEXIBLE_P010"],
        default: [],
    }) + select(soong_config_variable("openmax", "USE_FULL_ST2094_40"), {
        "true": ["-DUSE_FULL_ST2094_40"],
        default: [],
    }) + select(soong_config_variable("openmax", "GPU_TYPE"), {
        "sgpu": [
            "-DHW_GPU_ALIGN=256",
            "-DYV12_ALIGN=512",
        ],
        default: [],
    }) + select(soong_config_variable("openmax", "USE_SUPPORT_GPU_SBWC"), {
        "true": ["-DUSE_SUPPORT_GPU_SBWC"],
        default: [],
    }) + select(soong_config_variable("openmax", "USE_SMALL_SECURE_MEMORY"), {
        "true": ["-DUSE_SMALL_SECURE_MEMORY"],
        default: [],
    }) + select(soong_config_variable("openmax", "MAX_SECURE_RESOURCE"), {
        any @ flag_val: ["-DMAX_SECURE_RESOURCE=" + flag_val],
        default: [],
    }) + select(soong_config_variable("openmax", "USE_CSC_FILTER"), {
        "true": ["-DUSE_CSC_FILTER"],
        default: [],
    }) + select(soong_config_variable("openmax", "SUPPORT_MFC_ENC_RGB"), {
        "true": ["-DSUPPORT_MFC_ENC_RGB"],
        default: [],
    }) + select(soong_config_variable("openmax", "USE_BLOB_ALLOCATOR"), {
        "true": ["-DUSE_BLOB_ALLOCATOR"],
        default: [],
    }) + select(soong_config_variable("openmax", "USE_QUERY_HDR2SDR"), {
        "true": ["-DUSE_QUERY_HDR2SDR"],
        default: [],
    }) + select(soong_config_variable("openmax", "UNSUPPORT_10BIT"), {
        "true": ["-DUNSUPPORT_10BIT"],
        default: [],
    }) + select(soong_config_variable("openmax", "USE_FILMGRAIN_FILTER"), {
        "true": ["-DUSE_FILMGRAIN_FILTER"],
        default: [],
    }) + select(soong_config_variable("openmax", "USE_GDC"), {
        "true": ["-DUSE_GDC_FILTER"],
        default: [],
    }),
}

cc_defaults {
    name: "libExynosC2_dec_defaults",
    defaults: ["libExynosC2_defaults"],
    srcs: [
        "c2component/Exynos_C2_DecComponent.cpp",
        "filter/codec/Exynos_CodecDecBase_Filter.cpp",
    ],
}

