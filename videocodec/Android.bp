package {
    default_applicable_licenses: [
        "hardware_samsung_slsi-linaro_codec2_videocodec_license",
    ],
}

// Added automatically by a large-scale-change
// See: http://go/android-license-faq
license {
    name: "hardware_samsung_slsi-linaro_codec2_videocodec_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "NOTICE",
    ],
}

cc_library_headers {
    name: "libexynosc2_videocodec_headers",
    proprietary: true,
    compile_multilib: "both",
    export_include_dirs: ["./"],
    header_libs: [
        "libexynosc2_base_headers",
        "libexynosc2_osal_headers",
        "libexynos_videoapi_headers",
    ],
    export_header_lib_headers: [
        "libexynosc2_base_headers",
        "libexynosc2_osal_headers",
        "libexynos_videoapi_headers",
    ],
}

subdirs = [
    "libExynosVideoApi",
]

cc_library_static {
    name: "libExynosVideoCodec",
    proprietary: true,
    cflags: [
        "-fPIC",
        "-O3",
        "-Werror",
        "-Wall",
        "-std=gnu++1z",
        "-std=c++2a",
    ] + select(soong_config_variable("openmax", "USE_DEC_SW_CSC"), {
        "true": ["-DUSE_DEC_SW_CSC"],
        default: [],
    }) + select(soong_config_variable("openmax", "legacy_mfc"), {
        "true": ["-DLEGACY_MFC"],
        default: [],
    }),
    header_libs: [
        "libexynosc2_videocodec_headers",
        "libexynosc2_codecfilter_headers",
        "libexynos_headers",
    ],
    static_libs: [
        "libExynosC2OSAL",
        "libExynosVideoApi2",
    ],
    shared_libs: [
        "libcutils",
        "libhardware",
        "libhidlbase",
        "libexynosv4l2",
        "libion_exynos",
        "libui",
        "libexynosgraphicbuffer",
    ],
    srcs: [
        "ExynosVideoCodec.cpp",
        "ExynosVideoCodecBase.cpp",
        "ExynosVideoCodecCommon.cpp",
        "ExynosVideoCodecDec.cpp",
        "ExynosVideoCodecEnc.cpp",
    ],
}
