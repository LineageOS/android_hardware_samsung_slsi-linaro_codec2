package {
    default_applicable_licenses: [
        "hardware_samsung_slsi-linaro_codec2_videocodec_libExynosVideoApi_license",
    ],
}

// Added automatically by a large-scale-change
// See: http://go/android-license-faq
license {
    name: "hardware_samsung_slsi-linaro_codec2_videocodec_libExynosVideoApi_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "NOTICE",
    ],
}

cc_library_headers {
    name: "libexynos_videoapi_headers",
    proprietary: true,
    compile_multilib: "both",
    export_include_dirs: [
        "./",
        "include",
        "common",
        "mfc_headers",
        "osal/include",
    ],
    header_libs: [
        "libexynosc2_base_headers",
        "libexynosc2_osal_headers",
    ],
    export_header_lib_headers: [
        "libexynosc2_base_headers",
        "libexynosc2_osal_headers",
    ],
}

cc_library_static {
    name: "libExynosVideoApi2",
    proprietary: true,

    cflags: [

        "-Wno-unused-variable",
        "-Wno-unused-label",
        "-Wno-unused-function",
        "-DUSE_ANDROID",
        "-DUSE_USER_POLL_EVENT",
    ] + select(soong_config_variable("openmax", "MAINLINE_FEATURE_IN_SINCE_4_19"), {
        "true": ["-DMAINLINE_FEATURE_IN_SINCE_4_19"],
        default: [],
    }) + select(soong_config_variable("openmax", "USE_HEVC_HWIP"), {
        "true": ["-DUSE_HEVC_HWIP"],
        default: [],
    }) + select(soong_config_variable("openmax", "USE_SINGLE_PALNE_SUPPORT"), {
        "true": ["-DUSE_SINGLE_PALNE_SUPPORT"],
        default: [],
    }) + select(soong_config_variable("openmax", "FRAMERATE_THRESH_HOLD"), {
        any @ flag_val: ["-DFRAMERATE_THRESH_HOLD=" + flag_val],
        default: [],
    }) + select(soong_config_variable("openmax", "USE_SUPPORT_GPU_SBWC"), {
        "true": ["-DUSE_SUPPORT_GPU_SBWC"],
        default: [],
    }) + select(soong_config_variable("openmax", "use_epoll"), {
        "false": [],
        default: ["-DUSE_EPOLL"],
    }) + select(soong_config_variable("openmax", "legacy_mfc"), {
        "true": ["-DLEGACY_MFC"],
        default: [],
    }),

    header_libs: [
        "device_kernel_headers",
        "libexynos_videoapi_headers",
        "libexynos_headers",
    ],

    shared_libs: [
        "libion_exynos",
        "liblog",
    ],

    srcs: [
        "ExynosVideoInterface.c",
        "common/ExynosVideoCommonApi.c",
        "osal/ExynosVideo_OSAL.c",
        "dec/ExynosVideoDecoder.c",
        "enc/ExynosVideoEncoder.c",
    ],
}
