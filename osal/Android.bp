package {
    default_applicable_licenses: ["hardware_samsung_slsi-linaro_codec2_osal_license"],
}

// Added automatically by a large-scale-change
// See: http://go/android-license-faq
license {
    name: "hardware_samsung_slsi-linaro_codec2_osal_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "NOTICE",
    ],
}

cc_library_headers {
    name: "libexynosc2_osal_headers",
    proprietary: true,
    compile_multilib: "both",
    export_include_dirs: ["./"],
    header_libs: [
        "media_plugin_headers",
        "libexynosc2_base_headers",
    ],
    export_header_lib_headers: [
        "media_plugin_headers",
        "libexynosc2_base_headers",
    ],
}

cc_library_static {
    name: "libExynosC2OSAL",
    proprietary: true,
    cflags: [
        "-fPIC",
        "-O3",
        "-Werror",
        "-Wall",
        "-std=gnu++1z",
        "-std=c++2a",
    ],
    header_libs: [
        "libexynosc2_base_headers",
        "libexynosc2_osal_headers",
        "libexynos_headers",
    ],
    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
        "libcodec2",
        "libcodec2_vndk",
        "libhidlbase",
        "libstagefright_foundation_defaults",
        "libion",
        "libion_exynos",
        "libui",
        "libexynosgraphicbuffer",
    ],
    srcs: [
        "ExynosBufferAllocator.cpp",
        "ExynosETC.cpp",
        "ExynosLog.cpp",
        "ExynosIONUtils.cpp",
        "ExynosBufferManager.cpp",
    ],
}
