cc_library_headers {
    name: "libexynosc2_gdc_headers",
    proprietary: true,
    compile_multilib: "both",
    export_include_dirs: [
        "./",
    ],
    header_libs: [
        "libexynosc2_base_headers",
        "libexynosc2_osal_headers",
    ],
    export_header_lib_headers: [
        "libexynosc2_base_headers",
        "libexynosc2_osal_headers",
    ],
}

cc_library_static {
    name: "libExynosGDCWrapper",
    proprietary: true,
    cflags: [
        "-fPIC",
        "-O3",
        "-Werror",
        "-Wall",
        "-std=gnu++1z",
        "-std=c++2a",
    ] + select(soong_config_variable("openmax", "USE_FULL_ST2094_40"), {
        true: ["-DUSE_FULL_ST2094_40"],
        default: [],
    }),
    header_libs: [
        "libexynosc2_gdc_headers",
        "libexynos_headers",
    ],
    static_libs: [
        "libExynosC2OSAL",
    ],
    shared_libs: [
        "libcutils",
        "libutils",
        "libhardware",
        "libexynosgdc",
    ],
    srcs: [
        "ExynosGDCWrapper.cpp",
    ],
}
